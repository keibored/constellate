{
  "name": "constellate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "db:setup": "npm run db:setup --prefix server",
    "db:start": "npm run db:start --prefix server",
    "db:stop": "npm run db:stop --prefix server",
    "db:migrate": "npm run db:migrate --prefix server",
    "test:db": "npm run test:db --prefix server",
    "dev": "concurrently -k -n client,server -c cyan,magenta \"npm run dev --prefix client\" \"npm run dev --prefix server\"",
    "dev:client": "npm run dev --prefix client",
    "dev:server": "npm run dev --prefix server",
    "test": "npm test --prefix server",
    "build": "npm run build --prefix client && npm run build --prefix server"
  },
  "devDependencies": {
    "concurrently": "^9.2.2"
  }
}
