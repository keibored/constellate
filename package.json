{
  "name": "constellate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0 <25" },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "start": "node server/dist/index.js",
    "build:vercel": "node scripts/check-vercel-env.mjs && npm run build --workspace=client",
    "db:migrate:production": "node server/dist/db/migrate.js",
    "test:production": "npm run build && node server/test/browser/production.mjs",
    "deploy:verify": "npm run build --workspace=server && node server/test/browser/production.mjs --remote",
    "redis:setup": "npm run redis:setup --prefix server",
    "redis:start": "npm run redis:start --prefix server",
    "redis:stop": "npm run redis:stop --prefix server",
    "test:redis": "npm run test:redis --prefix server",
    "test:browser": "npm run test:browser --prefix server",
    "test:dev": "npm run test:dev --prefix server",
    "db:setup": "npm run db:setup --prefix server",
    "db:start": "npm run db:start --prefix server",
    "db:stop": "npm run db:stop --prefix server",
    "db:migrate": "npm run db:migrate --prefix server",
    "test:db": "npm run test:db --prefix server",
    "predev": "node --import tsx scripts/dev.ts check",
    "dev": "concurrently -k --handle-input --default-input-target server -n server,client -c magenta,cyan \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "dev:client": "npm run dev --prefix client",
    "dev:server": "npm run dev --prefix server",
    "test": "npm test --prefix server",
    "build": "npm run build --prefix client && npm run build --prefix server"
  },
  "devDependencies": {
    "concurrently": "^9.2.2"
  }
}
