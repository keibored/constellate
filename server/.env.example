# Single local backend port: the server and Vite proxy both read this setting.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Production ignores server/.env; configure variables in the host dashboard.
# Number of trusted proxy hops. 0 locally; 1 behind Render's edge proxy.
TRUST_PROXY_HOPS=0
LOG_LEVEL=info
HEALTH_TIMEOUT_MS=2000
SHUTDOWN_TIMEOUT_MS=25000
# Required shared realtime state. Local helper creates a loopback-only instance.
REDIS_URL=redis://127.0.0.1:6379
# Use the same prefix on all nodes for one PostgreSQL database/schema.
# Use a different prefix for each isolated deployment or test database.
REDIS_KEY_PREFIX=constellate
# Exact allowed browser origins for HTTP CORS and Socket.IO handshakes.
# Set your deployed frontend origin here in production; do not use a wildcard.
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Required by the backend. npm run db:setup can generate local credentials.
# Format: postgresql://USER:PERCENT_ENCODED_PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=
# Use a separate database for the PostgreSQL integration suite.
TEST_DATABASE_URL=
# Used only by db:setup when generating a project-local database URL.
LOCAL_POSTGRES_HOST=127.0.0.1
LOCAL_POSTGRES_PORT=5432
