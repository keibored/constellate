{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "redis:setup": "node scripts/local-redis.mjs setup",
    "redis:start": "node scripts/local-redis.mjs start",
    "redis:stop": "node scripts/local-redis.mjs stop",
    "test:redis": "npm run build && node --import tsx --test test/redis/*.test.ts",
    "test:browser": "npm run build && node test/browser/voice.mjs",
    "test:dev": "npm run build && node test/browser/dev-startup.mjs",
    "db:setup": "node scripts/local-postgres.mjs setup",
    "db:start": "node scripts/local-postgres.mjs start",
    "db:stop": "node scripts/local-postgres.mjs stop",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:production": "node dist/db/migrate.js",
    "test:db": "npm run build && node --import tsx --test test/database/*.test.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "node --import tsx --test test/*.test.ts && tsx --tsconfig ../client/tsconfig.app.json --test test/*.test.tsx"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.5",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "18.4.0-beta.17",
    "playwright": "^1.63.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
