# Leave blank to connect through the page origin (Vite proxies Socket.IO in development).
VITE_SERVER_URL=
# Required by the Vercel build: exact Render backend HTTPS origin, e.g. https://api.example.com.
# Used for BOTH HTTP statistics and Socket.IO. Rebuild after changes.
# Blank is valid only when the frontend host proxies /api and /socket.io.
# Development only. Leave blank to use PORT from server/.env (default 3000).
# Set an explicit URL only when proxying to a backend on another host.
SERVER_PROXY_TARGET=
# Optional JSON RTCIceServer array. Empty uses Google's public STUN for development.
# Example: [{"urls":"stun:stun.l.google.com:19302"}]
# [] permits host candidates only. Browser-visible TURN credentials must be short-lived.
VITE_ICE_SERVERS=
